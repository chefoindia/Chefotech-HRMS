# ─────────────────────────────────────────────────────────────────────────────
#  Secrets. Nothing in this block may ever be committed.
#
#  A leaked .env here is not a config mistake — it hands over the JWT signing
#  secrets, which is enough to mint a valid token for any user in any tenant,
#  and the super-admin password. Rotating after the fact does not undo it:
#  git history keeps the old values forever, and public repositories are
#  scraped for exactly these files within minutes.
#
#  `.env.example` is deliberately NOT ignored — it documents the shape without
#  the values.
# ─────────────────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*-service-account*.json
google-credentials*.json

# Dependencies
node_modules/
.pnp
.pnp.js

# Builds
.next/
.next-build/
out/
build/
dist/
.expo/
.expo-shared/
*.tsbuildinfo

# Native projects generated by `expo prebuild` — regenerated from app.json,
# so committing them creates two sources of truth for the same config.
mobile/ios/
mobile/android/

# Local file storage (STORAGE_DRIVER=local writes real uploads here)
.storage/
backend/.storage/

# Logs and coverage
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
coverage/
.nyc_output/

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
