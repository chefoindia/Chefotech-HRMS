# ─────────────────────────────────────────────────────────────────────────────
# Chefotech HRMS — API configuration
#
# Copy to .env and fill in. Never commit the real .env.
# Only MONGODB_URI and the two JWT secrets are required to run locally.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5001
API_PREFIX=/api/v1
APP_NAME=Chefotech HRMS

# Where the frontend runs. Used to build links inside emails.
PUBLIC_APP_URL=http://localhost:3000

# Comma-separated. Add every deployed frontend origin.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set to true when running behind a load balancer or reverse proxy, so req.ip
# reflects the real client rather than the proxy.
TRUST_PROXY=false

# ── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/chefotech_hrms
MONGODB_POOL_SIZE=20
MONGODB_TIMEOUT_MS=10000

# ── Authentication ───────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=30d
JWT_ISSUER=chefotech-hrms

# Cross-site cookies need SameSite=None and Secure, which is impossible over
# plain http. In local development leave these as-is; the frontend falls back
# to sending the access token as a Bearer header.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.chefotech.com

# ── Security ─────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ── File storage ─────────────────────────────────────────────────────────────
# drive = Google Drive (production). local = filesystem, for development.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./.storage
MAX_UPLOAD_BYTES=26214400

# Google Drive, via a service account.
#
#   1. Google Cloud Console → create a project → enable the Drive API.
#   2. Create a service account, then create a JSON key for it.
#   3. Paste the ENTIRE JSON below on one line, wrapped in single quotes.
#      The literal \n inside private_key is expected and handled.
#   4. Create a folder in Drive, share it with the service account's
#      client_email as Editor, and put its id in GOOGLE_DRIVE_ROOT_FOLDER_ID
#      (the last path segment of the folder's URL).
#
# Public files (logos, avatars) are shared with "anyone with the link" and
# served from https://lh3.googleusercontent.com/d/<fileId>=w<width>.
# Private files (documents, payslips) are never shared and are streamed only
# through the authenticated /files/:id/content proxy.
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Only when using a Shared Drive rather than My Drive:
GOOGLE_SHARED_DRIVE_ID=

# ── Email ────────────────────────────────────────────────────────────────────
# MUST be true in production. Left false (or simply absent — false is the
# default) every outbound email is dropped: password resets, invitations and
# payslip notices all report success and send nothing. In production the
# server now refuses the send outright rather than pretending, and warns at
# boot, but the setting is still the thing that has to be right.
#
# Locally, false is the sensible choice — mail is written to an in-memory
# outbox and logged, so a password reset can be walked through without a
# provider and without emailing real people.
MAIL_ENABLED=false

# Which transport sends. Defaults to brevo whenever BREVO_API_KEY is set,
# otherwise smtp. Brevo is an HTTPS API, which is what makes it work on hosts
# that block outbound port 587 — Render, Fly and most container platforms do.
MAIL_DRIVER=
BREVO_API_KEY=

# Brevo will reject the API key outright if the calling IP is not on the
# account's allow-list (Security → Authorised IPs). A server's outbound IP is
# not fixed on most hosts, so that restriction usually has to be OFF for a
# deployed app. The failure looks like an auth error, not an IP error, which
# is why it is called out here.

# The sender address must be VERIFIED with the provider. Brevo refuses to
# send from a domain it has no record of, so this cannot just be any address
# on any domain you happen to own.
MAIL_FROM=Chefotech HRMS <no-reply@chefotech.com>

# Only used when MAIL_DRIVER=smtp.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Where a reply to an automated email lands. Optional; a support inbox is the
# usual choice so "reply to this payslip email" reaches a person.
MAIL_REPLY_TO=

# ── Push notifications ───────────────────────────────────────────────────────
# Mobile push goes through Expo, which fronts APNs and FCM — no Apple or
# Google credentials are needed here. The access token is optional; it raises
# the rate limits and is required once the app enables enhanced push security.
EXPO_ACCESS_TOKEN=

# Browser push needs a VAPID key pair. Generate ONCE and keep forever — every
# browser subscription is bound to the public key, and rotating it silently
# unsubscribes everyone:
#   node -e "const w=require('web-push');console.log(w.generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@chefotech.com

# ── Background jobs ──────────────────────────────────────────────────────────
JOBS_ENABLED=true
JOBS_POLL_INTERVAL_MS=5000
JOBS_CONCURRENCY=3
JOBS_MAX_ATTEMPTS=5

# ── Platform super admin (created by `npm run seed`) ──────────────────────────
SUPER_ADMIN_EMAIL=admin@chefotech.com
SUPER_ADMIN_PASSWORD=ChangeMe@123456
SUPER_ADMIN_NAME=Chefotech Admin

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_PRETTY=true

# ── Image storage (Cloudinary) ───────────────────────────────────────────────
# Images are served from a CDN with transformations in the URL; documents stay
# in Drive. Leave blank to store images wherever STORAGE_DRIVER points.
IMAGE_STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=chefotech-hrms
